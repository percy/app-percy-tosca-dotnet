<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AppPercyTosca</RootNamespace>
    <AssemblyName>AppPercyTosca</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Do not copy the referenced Tricentis assemblies into the output folder.

       A <Reference> with a HintPath is CopyLocal by default, which would fill bin\ with 139 copies of
       Tosca's own assemblies alongside our one DLL. That is not merely wasteful: Tosca discovers an
       extension by scanning the folder you register, so pointing it at bin\ would have it load
       duplicate copies of its own engines — and the symptom is the extension silently failing to
       register, which is a long way from the cause.

       They are compile-time references only; at runtime Tosca supplies them from TBox, which is
       already where they came from. With this, bin\ holds just AppPercyTosca.dll and can be registered
       directly. -->
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <!-- The Core is compiled into this assembly rather than referenced as a project.

       Tosca loads an extension by pointing at a folder and picking up the DLLs in it; that folder is
       not an assembly probing path, so a second DLL next to this one is not reliably resolved when a
       type from it is first touched at runtime — which would surface as a TypeLoadException on the
       first PercyScreenshot step rather than at load time. Shipping one self-contained DLL removes
       the question. (Compiling the sources in, rather than post-processing with an IL merger, keeps
       the build to a plain `dotnet build` with no extra tooling.)

       The Core remains a real project with its own solution so CI can build and test it on a machine
       with no Tosca installed. -->
  <ItemGroup>
    <Compile Include="..\AppPercyTosca.Core\**\*.cs" Exclude="..\AppPercyTosca.Core\bin\**;..\AppPercyTosca.Core\obj\**" />
    <!-- LogicalName pinned: DeviceRegistry looks this resource up by name, and without it the name
         would be derived from this project's root namespace and the lookup would silently miss,
         leaving every iOS device unrecognised. -->
    <EmbeddedResource Include="..\AppPercyTosca.Core\resources\devices.json"
                      LogicalName="AppPercyTosca.Core.resources.devices.json" />
  </ItemGroup>

  <!-- The Tricentis assemblies ship with Tosca and are not redistributable, so this project only
       builds on a machine with Tosca Testsuite installed at the default location. Change the paths
       below if yours differs. The list mirrors the one the HTML SDK (percy/percy-tosca-dotnet)
       builds against, which is known to resolve on Tosca Commander 24 — it is broader than this
       extension strictly needs, but a missing reference is a build failure on the user's machine
       and an unused one costs nothing.

       Six references that the HTML SDK lists are deliberately absent: CloudServiceBase, FileScan,
       Mobile30.CloudIntegration, TestDataManagement, Shared.Authorization and
       Shared.Authorization.Abstractions do not ship with every Tosca 24 install (confirmed missing on
       one), and nothing here uses them. If your install lacks another, delete its Reference — an
       unresolved one is only a warning unless the code actually needs it.

       CI does not build this project (it cannot: no Tricentis DLLs on a runner). Only
       AppPercyTosca.Core.sln is built and tested there, which is why every piece of logic that can
       live in the Core does. -->
  <ItemGroup>
